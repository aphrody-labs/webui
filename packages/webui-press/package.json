{
  "name": "@microsoft/webui-press",
  "description": "Native WebUI Press documentation builder and shared browser appearance API",
  "license": "MIT",
  "version": "3.1.1",
  "publishConfig": {
    "tag": "latest"
  },
  "type": "module",
  "files": [
    "README.md",
    "dist/"
  ],
  "exports": {
    "./appearance.js": {
      "types": "./dist/appearance.d.ts",
      "import": "./dist/appearance.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc --project tsconfig.json",
    "prepack": "bun run build",
    "build:test": "bun check -p tsconfig.test.json",
    "build:e2e": "cargo build -p microsoft-webui-cli -p microsoft-webui-press && bun run --filter @webui/docs... build && bun run build:test",
    "test:e2e": "bun test --isolate ./tests ../../docs/.webui-press/components ../../docs/.webui-press/regions ../../docs/.webui-press/scripts ../../docs/start",
    "test": "bun run build:e2e && bun run test:e2e",
    "typecheck": "bun check && bun check -p tsconfig.test.json"
  },
  "optionalDependencies": {
    "@microsoft/webui-press-darwin-arm64": "workspace:*",
    "@microsoft/webui-press-darwin-x64": "workspace:*",
    "@microsoft/webui-press-linux-arm64": "workspace:*",
    "@microsoft/webui-press-linux-x64": "workspace:*",
    "@microsoft/webui-press-win32-arm64": "workspace:*",
    "@microsoft/webui-press-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/webui": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
