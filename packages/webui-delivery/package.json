{
  "description": "Renderer-independent resource and state delivery for WebUI routing.",
  "devDependencies": {
    "@microsoft/webui-framework": "workspace:*",
    "@microsoft/webui-delivery": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/dom-navigation": "catalog:",
    "@types/dom-view-transitions": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "urlpattern-polyfill": "catalog:"
  },
  "exports": {
    "./router.js": {
      "import": {
        "types": "./dist/router.d.ts",
        "default": "./dist/router.js"
      }
    },
    "./resources.js": {
      "import": {
        "types": "./dist/resources-entry.d.ts",
        "default": "./dist/resources-entry.js"
      }
    }
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "!dist/browser-shim.*"
  ],
  "license": "MIT",
  "name": "@microsoft/webui-delivery",
  "scripts": {
    "build": "bunx --bun tsc",
    "prepack": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bunx --bun tsc --incremental false",
    "build:e2e": "bun build tests/fixtures/router-app/src/index.ts tests/fixtures/router-app/src/interaction-entry.ts --outdir=tests/fixtures/router-app/dist --format=esm --splitting --sourcemap=linked --tsconfig-override=tsconfig.e2e.json && bun build tests/fixtures/router-app/src/lean-entry.ts --outfile=tests/fixtures/router-app/dist/lean-entry.js --format=esm --sourcemap=linked --tsconfig-override=tsconfig.e2e.json",
    "start:server": "cargo run -p microsoft-webui-cli -- serve ./tests/fixtures/router-app/src --plugin=webui --servedir ./tests/fixtures/router-app/dist --state ./tests/fixtures/router-app/data/state.json --port 39102",
    "test:unit": "bunx --bun tsc -p tsconfig.unit-test.json --incremental false && bun test --isolate ./dist-test",
    "test": "bun run test:unit && bun run build:e2e && bunx --bun playwright test",
    "test:e2e": "bunx --bun playwright test",
    "test:update-snapshots": "bunx --bun playwright test --update-snapshots",
    "typecheck": "bun check"
  },
  "type": "module",
  "publishConfig": {
    "tag": "latest"
  },
  "version": "3.1.1"
}
