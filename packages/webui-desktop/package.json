{
  "name": "@microsoft/webui-desktop",
  "version": "3.1.1",
  "description": "Opt-in native desktop CLI and typed browser IPC runtime for WebUI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/local-index.d.ts",
      "import": "./dist/local-index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "bunx --bun tsc && bun scripts/build.mjs",
    "typecheck": "bun check",
    "test": "bun run build && bun scripts/stage-rust-assets.mjs --write && bunx --bun tsc -p tsconfig.test.json && bun test --isolate ./dist-test"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@microsoft/webui-desktop-darwin-arm64": "workspace:*",
    "@microsoft/webui-desktop-darwin-x64": "workspace:*",
    "@microsoft/webui-desktop-linux-arm64": "workspace:*",
    "@microsoft/webui-desktop-linux-x64": "workspace:*",
    "@microsoft/webui-desktop-win32-arm64": "workspace:*",
    "@microsoft/webui-desktop-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "tag": "latest"
  }
}
