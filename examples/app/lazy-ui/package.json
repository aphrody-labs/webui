{
  "name": "lazy-ui-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "webuiProjectionManifest": "./dist/webui-projection.json",
  "scripts": {
    "build": "bun run build:deps && bun build.mjs && bun run typecheck",
    "build:deps": "cargo build --release -p microsoft-webui-node && bun run --filter @microsoft/webui --filter @microsoft/webui-framework build",
    "build:modules": "cargo run -p microsoft-webui-cli -- build ./src --plugin=webui --theme=@microsoft/webui-examples-theme --out ./dist --modules-out ./.webui",
    "build:client": "bun ../../build-client.mjs",
    "build:protocol": "cargo run -p microsoft-webui-cli -- build ./src --plugin=webui --projection-manifest ./dist/webui-projection.json --theme=@microsoft/webui-examples-theme --out ./dist --modules-out ./.webui",
    "typecheck": "bun check && bun check -p tsconfig.test.json",
    "start:client": "bun run build:deps && bun run build:modules && bun ../../build-client.mjs --watch",
    "start:api": "bun server/index.mjs --port 3021",
    "start:server": "cargo run -p microsoft-webui-cli -- serve ./src --state ./data/state.json --plugin=webui --projection-manifest ./dist/webui-projection.json --theme=@microsoft/webui-examples-theme --modules-out ./.webui --servedir ./dist --port 3011 --api-port 3021 --watch",
    "start": "cargo xtask dev lazy-ui",
    "test": "bun run test:server && bunx --bun playwright test",
    "test:server": "bun test --isolate ./server/api.test.mjs",
    "test:update-snapshots": "bunx --bun playwright test --update-snapshots"
  },
  "devDependencies": {
    "@microsoft/webui": "workspace:*",
    "@microsoft/webui-examples-theme": "workspace:*",
    "@microsoft/webui-framework": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  }
}
