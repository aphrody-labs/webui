{
  "name": "streaming-example",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "webuiProjectionManifest": "./dist/webui-projection.json",
  "scripts": {
    "build": "bun run build:deps && bun run build:client && bun run build:server",
    "build:deps": "bun run --filter @microsoft/webui --filter @microsoft/webui-framework build",
    "build:client": "bun ./build-client.mjs",
    "build:server": "bun check -p server/tsconfig.json && bun build server/src/index.ts --target=node --format=esm --outfile=server/dist/index.js",
    "start:client": "bun run build:deps && bun ./build-client.mjs --watch",
    "start:api": "bun --watch server/src/index.ts --port 3030",
    "start:test-api": "bun server/src/index.ts --port 3030 --test-controls --max-concurrent-streams 16",
    "start:server": "cargo run -p microsoft-webui-cli -- serve ./src --theme=@microsoft/webui-examples-theme --plugin=webui --projection-manifest ./dist/webui-projection.json --servedir ./dist --css style --port 3020 --api-port 3030 --watch",
    "start:test-server": "cargo run -p microsoft-webui-cli -- serve ./src --theme=@microsoft/webui-examples-theme --plugin=webui --projection-manifest ./dist/webui-projection.json --servedir ./dist --css style --port 3020 --api-port 3030",
    "start": "cargo xtask dev streaming",
    "test": "bun run test:server && bunx --bun playwright test",
    "test:server": "bun test --isolate ./server/src",
    "test:update-snapshots": "bunx --bun playwright test --update-snapshots"
  },
  "devDependencies": {
    "@microsoft/webui": "workspace:*",
    "@microsoft/webui-examples-theme": "workspace:*",
    "@microsoft/webui-framework": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  }
}
