{
  "name": "routes-example",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build:deps && bun run build:client && bun run build:protocol",
    "build:deps": "bun run --filter @microsoft/webui --filter @microsoft/webui-framework --filter @microsoft/webui-delivery build",
    "build:protocol": "cargo run -p microsoft-webui-cli -- build ./src --plugin=webui --projection-manifest ./dist/webui-projection.json --out ./dist",
    "build:client": "bun ../../build-client.mjs",
    "start:client": "bun run build:deps && bun ../../build-client.mjs --watch",
    "start:api": "cd server && bun run start",
    "start:server": "cargo run -p microsoft-webui-cli -- serve ./src --plugin=webui --projection-manifest ./dist/webui-projection.json --servedir ./dist --port 3008 --api-port 3018 --watch",
    "start": "cargo xtask dev routes",
    "test": "bunx --bun playwright test",
    "test:update-snapshots": "bunx --bun playwright test --update-snapshots"
  },
  "devDependencies": {
    "@microsoft/webui": "workspace:*",
    "@microsoft/webui-framework": "workspace:*",
    "@microsoft/webui-delivery": "workspace:*",
    "@playwright/test": "catalog:",
    "esbuild": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  }
}
