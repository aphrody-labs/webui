{
  "name": "service-worker-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:deps && bun run copy:wasm && bun run typecheck && bun run build:client && bun run build:protocol && bun run inject:theme && bun run check:render",
    "build:deps": "bun run --filter @microsoft/webui build",
    "build:protocol": "cargo run -p microsoft-webui-cli -- build ./src --out ./public/protocol.bin --plugin=webui --projection-manifest ./public/webui-projection.json --css style",
    "copy:wasm": "bun scripts/copy-wasm.ts",
    "inject:theme": "bun scripts/inject-theme.ts",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.worker.json",
    "build:client": "bun build-client.mjs",
    "check:render": "bun scripts/check-render.ts",
    "start:server": "bun run build && bun scripts/serve.ts --port 4175",
    "start:client": "bun build-client.mjs --watch",
    "start": "cargo xtask dev service-worker",
    "test": "bun run build && bunx --bun playwright test"
  },
  "devDependencies": {
    "@microsoft/webui": "workspace:*",
    "@microsoft/webui-examples-theme": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
