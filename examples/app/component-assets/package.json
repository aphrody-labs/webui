{
  "name": "component-assets-example",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run clean && bun run build:deps && bun build.mjs && bun run copy:data && bun run verify:performance",
    "clean": "bun -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('.webui',{recursive:true,force:true})\"",
    "build:deps": "cargo build --release -p microsoft-webui-node && bun run --filter @microsoft/webui --filter @microsoft/webui-framework build",
    "build:assets": "cargo run -p microsoft-webui-cli -- build ./src --plugin=webui --out ./dist --emit-component-assets lazy-panel,secondary-panel --modules-out ./.webui --metafile ./dist/component-assets.meta.json --theme=@microsoft/webui-examples-theme",
    "build:protocol": "cargo run -p microsoft-webui-cli -- build ./src --plugin=webui --projection-manifest ./dist/webui-projection.json --out ./dist --emit-component-assets lazy-panel,secondary-panel --modules-out ./.webui --metafile ./dist/component-assets.meta.json --theme=@microsoft/webui-examples-theme",
    "build:client": "bun ./build-client.mjs",
    "copy:data": "bun -e \"require('node:fs').copyFileSync('src/lazy-panel-data.json','dist/lazy-panel-data.json')\"",
    "verify:performance": "bun ./tests/performance-budget.mjs",
    "start:client": "bun run build:deps && bun run build:assets && bun ../../build-client.mjs --watch",
    "start:server": "cargo run -p microsoft-webui-cli -- serve ./src --state ./data/state.json --theme=@microsoft/webui-examples-theme --plugin=webui --projection-manifest ./dist/webui-projection.json --emit-component-assets lazy-panel,secondary-panel --modules-out ./.webui --metafile ./dist/component-assets.meta.json --servedir ./dist --port 3010 --watch",
    "start": "cargo xtask dev component-assets",
    "test": "bunx --bun playwright test",
    "test:update-snapshots": "bunx --bun playwright test --update-snapshots"
  },
  "devDependencies": {
    "@microsoft/webui": "workspace:*",
    "@microsoft/webui-examples-theme": "workspace:*",
    "@microsoft/webui-framework": "workspace:*",
    "@playwright/test": "catalog:",
    "esbuild": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  }
}
