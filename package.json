{
  "name": "webui",
  "version": "3.1.1",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "docs",
      "examples/**",
      "packages/*",
      "!**/test/**",
      "!**/bin/**",
      "!**/obj/**"
    ],
    "catalog": {
      "@codemirror/commands": "^6.11.0",
      "@codemirror/lang-css": "^6.3.1",
      "@codemirror/lang-html": "^6.4.12",
      "@codemirror/lang-json": "^6.0.2",
      "@codemirror/language": "^6.12.4",
      "@codemirror/state": "^6.7.4",
      "@codemirror/theme-one-dark": "^6.1.3",
      "@codemirror/view": "^6.43.11",
      "@microsoft/fast-element": "3.0.3",
      "@playwright/test": "^1.63.0",
      "@types/bun": "^1.4.4",
      "@types/dom-navigation": "^1.0.7",
      "@types/dom-view-transitions": "^1.0.6",
      "urlpattern-polyfill": "^10.1.0",
      "@types/node": "^26.5.1",
      "electron": "^44.9.1",
      "esbuild": "^0.28.2",
      "tslib": "^2.8.1",
      "typescript": "7.0.2",
      "typescript-6": "npm:typescript@6.0.3"
    }
  },
  "scripts": {
    "build": "bun run --filter @microsoft/webui --filter @microsoft/webui-framework --filter @microsoft/webui-delivery build",
    "check": "bun run --filter @microsoft/webui --filter @microsoft/webui-framework --filter @microsoft/webui-delivery --filter @microsoft/webui-desktop --filter @microsoft/webui-press typecheck",
    "test": "bun run --filter @microsoft/webui --filter @microsoft/webui-delivery test"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": "Microsoft Edge",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:"
  }
}
